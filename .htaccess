<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Sempre HTTPS (mantem o dominio digitado, com ou sem www)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Arquivos internos do projeto: nunca servir (403) ---
    # Pastas de trabalho que o deploy envia junto
    RewriteRule ^(scripts|deploy|templates|scratch|\.github|\.git|Design.sem.nome|Professores.faltantes)(/|$) - [F,NC]
    # Dados: so o database.json e publico (usado pelas paginas de webinar)
    RewriteCond %{REQUEST_URI} !^/data/database\.json$
    RewriteRule ^data/ - [F]
    # Documentos, planilhas, scripts e dumps (exceto robots.txt e data/database.json)
    RewriteCond %{REQUEST_URI} !^/robots\.txt$
    RewriteCond %{REQUEST_URI} !^/data/database\.json$
    RewriteRule \.(md|json|txt|py|xlsx|stl|yml|yaml|gitignore)$ - [F,NC]
    # Paginas de teste, backup e rascunhos de e-mail
    RewriteRule ^(teste_antigravity|live_backup|email-1-lembrete|email-2-ao-vivo|proposta)(\.html)?$ - [F,NC]

    # Paginas desativadas: links antigos vao para o destino certo
    # BC Amazon Week tem site oficial proprio
    RewriteRule ^bc_amazon_week(\.html)?$ https://www.bcamazonweek.com.br/ [R=301,L,NC]
    # Curso Ileal (pre-congresso) foi cancelado
    RewriteRule ^(ileal_surgery|obrigado_ileal)(\.html)?$ / [R=301,L,NC]

    # Redirect root to home.html
    RewriteRule ^$ home.html [L]

    # Redirect /professores to professors/corpo_docente.html
    RewriteRule ^professores/?$ professores/corpo_docente.html [L,R=301]

    # Clean URLs: Allow access without .html extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [NC,L]

    # Ensure mp4 files are served with correct MIME type
    AddType video/mp4 .mp4
</IfModule>

# Paginas HTML: o navegador sempre confere se ha versao nova (agenda muda com frequencia).
# Imagens continuam em cache por 7 dias.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|mp4)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
